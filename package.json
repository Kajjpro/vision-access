{
  "name": "vision-access",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "prebuild": "node --env-file-if-exists=.env.local scripts/build-transit-data.mjs && tsx scripts/build-stop-keys.ts && node scripts/setup-tesseract.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "transit": "node --env-file-if-exists=.env.local scripts/build-transit-data.mjs",
    "transit:refresh": "node --env-file-if-exists=.env.local scripts/build-transit-data.mjs --refresh && tsx scripts/build-stop-keys.ts",
    "test": "tsx --test \"lib/*.test.ts\" \"lib/**/*.test.ts\" \"scripts/*.test.ts\" \"scripts/**/*.test.ts\"",
    "audio:transit": "tsx scripts/generate-transit-audio.ts",
    "audio:routes": "tsx scripts/generate-transit-audio.ts --stage=routes",
    "money:refs": "tsx scripts/build-money-refs.ts",
    "money:eval": "tsx scripts/eval-money.ts",
    "stop-keys": "tsx scripts/build-stop-keys.ts",
    "stop-keys:check": "tsx scripts/build-stop-keys.ts --check",
    "aliases": "tsx scripts/generate-stop-aliases.ts",
    "aliases:review": "tsx scripts/generate-stop-aliases.ts --review",
    "aliases:dry": "tsx scripts/generate-stop-aliases.ts --dry-run",
    "stt:accuracy": "tsx scripts/stt-accuracy.ts",
    "ocr:setup": "node scripts/setup-tesseract.mjs",
    "dev:http": "next dev",
    "dev:cert": "node scripts/dev-cert.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@huggingface/transformers": "^4.2.0",
    "next": "16.3.0",
    "onnxruntime-web": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
